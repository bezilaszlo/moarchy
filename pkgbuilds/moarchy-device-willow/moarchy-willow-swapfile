#!/bin/sh
# 4 GB of RAM and no ZRAM in this kernel, so swap is a file on userdata.
set -eu

file=/var/swapfile
size_mib=2048
# Leave room: a full rootfs makes logind and every StateDirectory= unit fail with ENOSPC.
keep_mib=1024

if [ ! -f "$file" ]; then
  free_mib=$(df -Pm /var | awk 'NR==2 {print $4}')
  if [ "${free_mib:-0}" -lt $(( size_mib + keep_mib )) ]; then
    echo "only ${free_mib}M free on /var; no swapfile (did the rootfs grow?)" >&2
    exit 0
  fi
  mkswap -U clear --size "${size_mib}M" --file "$file" >/dev/null || { rm -f "$file"; exit 1; }
fi
if ! grep -q "^$file " /proc/swaps; then
  swapon "$file"
fi
