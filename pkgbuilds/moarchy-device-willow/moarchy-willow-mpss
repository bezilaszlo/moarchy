#!/bin/sh
set -eu
# PAS remoteproc is not the MSS-PIL device that rmtfs -s knows how to start.
find_mpss() {
  for proc in /sys/class/remoteproc/remoteproc*; do
    [ -r "$proc/firmware" ] || continue
    [ "$(cat "$proc/firmware")" = qcom/sm6125/xiaomi/ginkgo/modem.mdt ] || continue
    echo "$proc"
    return 0
  done
  return 1
}

# 60 s to appear plus 20 s to run stays inside the unit's TimeoutStartSec=90.
mpss=
for _ in $(seq 1 60); do
  mpss=$(find_mpss) && break
  sleep 1
done
[ -n "$mpss" ] || { echo 'MPSS remoteproc did not appear' >&2; exit 1; }

state=$(cat "$mpss/state")
case "$state" in
  running) exit 0 ;;
  offline) printf 'start\n' > "$mpss/state" ;;
  *) echo "MPSS is $state; refusing to restart a failing remoteproc" >&2; exit 1 ;;
esac

for _ in $(seq 1 20); do
  [ "$(cat "$mpss/state")" = running ] && exit 0
  sleep 1
done
echo "MPSS is $(cat "$mpss/state"), not running" >&2
exit 1
